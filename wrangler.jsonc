// Cloudflare-Konfiguration: Die App ist eine statische Seite (Ordner dist).
// Unbekannte Pfade liefern index.html aus, damit Links wie /felder direkt funktionieren.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schweikhof-app",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
